# Supabase (same values as dashboard — anon key is safe for frontend)
# Supabase — backend (same project URL as frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional - ONLY for projects still on legacy HS256 signing. Projects using asymmetric
# (ES256/RS256) signing keys need nothing here: the API verifies tokens against the public
# JWKS at $SUPABASE_URL/auth/v1/.well-known/jwks.json. Check your mode in
# Dashboard -> Project Settings -> Auth -> JWT Keys.
SUPABASE_JWT_SECRET=

# FastAPI (apps/api)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Service identity + observability
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                    # true in production for structured log ingestion

# Outbound HTTP pool (one shared client for the whole process)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20

# Rate limiting (per authenticated user, falling back to client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute

# Uploads
PROPOSALS_BUCKET=proposals
MAX_UPLOAD_BYTES=52428800         # 50 MiB

# Google OAuth (calendar — Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Points at the *web app*, not the API: the browser redirect carries no bearer token, so
# the page that holds the session posts the code to the API to be exchanged.
GOOGLE_REDIRECT_URI=http://localhost:3000/settings/google/callback

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker (Phase 4+)
REDIS_URL=redis://localhost:6379/0
RESEND_API_KEY=
