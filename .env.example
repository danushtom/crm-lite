# Supabase (same values as dashboard — anon key is safe for frontend)
# Supabase — backend (same project URL as frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# FastAPI (apps/api)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Google OAuth (calendar — Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker (Phase 4+)
REDIS_URL=redis://localhost:6379/0
RESEND_API_KEY=
