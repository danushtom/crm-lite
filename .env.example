# Supabase (same values as dashboard — anon key is safe for frontend)
# Supabase — backend (same project URL as frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional - ONLY for projects still on legacy HS256 signing. Projects using asymmetric
# (ES256/RS256) signing keys need nothing here: the API verifies tokens against the public
# JWKS at $SUPABASE_URL/auth/v1/.well-known/jwks.json. Check your mode in
# Dashboard -> Project Settings -> Auth -> JWT Keys.
SUPABASE_JWT_SECRET=

# FastAPI (apps/api)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Public origin of the web app: invite emails and billing checkout/portal return here.
WEB_APP_URL=http://localhost:3000

# Service identity + observability
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                    # true in production for structured log ingestion

# Outbound HTTP pool (one shared client for the whole process)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20

# Rate limiting (per authenticated user, falling back to client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute

# Uploads
PROPOSALS_BUCKET=proposals
MAX_UPLOAD_BYTES=52428800         # 50 MiB

# Google OAuth (calendar — Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Points at the *web app*, not the API: the browser redirect carries no bearer token, so
# the page that holds the session posts the code to the API to be exchanged.
GOOGLE_REDIRECT_URI=http://localhost:3000/settings/google/callback

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker
REDIS_URL=redis://localhost:6379/0
# Daily brief to each organization's admins. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Dracara Growth OS <onboarding@resend.dev>

# Production hardening (SETUP.md, "Deploying")
# Shared rate-limit counters; memory:// is per process. e.g. redis://localhost:6379/1
RATE_LIMIT_STORAGE_URI=memory://
# Error monitoring for the API and worker; blank disables it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Build identifier (e.g. git SHA), tagged on errors.
RELEASE=
# Qdrant auth, required whenever Qdrant is reachable by anything but this machine.
QDRANT_API_KEY=

# Voice agents (AI calling) — optional; the rest of the app works without these.
# See SETUP.md section 7 for the full walkthrough, including the local webhook tunnel.
VOICE_PLATFORM=vapi
VOICE_PLATFORM_API_KEY=
VOICE_PLATFORM_API_BASE=https://api.vapi.ai
VOICE_PLATFORM_WEBHOOK_SECRET=
VOICE_KB_BUCKET=voice-agent-docs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Publicly reachable base URL for this API (an ngrok tunnel in development), so the voice
# platform's webhooks can reach it.
API_PUBLIC_BASE_URL=

# Billing -- Dodo Payments (SETUP.md section 9). Without the key and webhook secret, billing
# reports itself as unconfigured; every organization still gets its 14-day trial.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test    # test | live
DODO_PAYMENTS_WEBHOOK_SECRET=     # whsec_... from the Dodo dashboard's webhook endpoint
DODO_PRODUCT_STARTER=             # per-seat monthly subscription product ids
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=
